---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- assign pages = site.pages | sort: "url" %}
{%- for p in pages %}
  {%- if p.sitemap == false or p.noindex or p.redirect %}{% continue %}{% endif %}
  {%- assign last_segment = p.url | split: "/" | last %}
  {%- if last_segment contains "." %}{% unless last_segment contains ".html" %}{% continue %}{% endunless %}{% endif %}
  <url>
    <loc>{{ site.canonical }}{{ p.url | replace: "/index.html", "/" }}</loc>
    <lastmod>{{ p.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod>
    {%- if p.url == "/" %}
    <image:image>
      <image:loc>{{ site.canonical }}{{ site.avatar }}</image:loc>
    </image:image>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
